import "trilogy:debug" use dbg
import "trilogy:core" as core
import "trilogy:array" as array
import "trilogy:iterator" as it

export contains_key, merge_by, collect, update, group, group_by

func replace_using cmp key value record =
  if contains_key key record
    then {| ..record, key => cmp key value (record.key) |}
    else {| ..record, key => value |}

func update updater default key record =
  if contains_key key record
    then {| ..record, key => updater (record.key) |}
    else {| ..record, key => updater default |}

test "record update" {
  let mut record = {| |}
  record = update ((+) 1) 0 'a record
  record = update ((+) 1) 0 'b record
  record = update ((+) 1) 0 'a record
  record = update ((+) 1) 0 'c record
  assert record == {| 'a => 2, 'b => 1, 'c => 1 |}
}

func merge_by merger lhs rhs =
  rhs
  |> core::to_array
  |> array::fold (fn k:v state. replace_using merger k v state) lhs

test "record merge_by" {
  let max = fn key lhs rhs. if lhs > rhs then lhs else rhs
  assert merge_by max {| 'a => 1, 'b => 2, 'c => 3 |} {| 'a => 3, 'b => 1, 'c => 2 |} == {| 'a => 3, 'b => 2, 'c => 3 |}
}

func contains_key val record and typeof 'record = core::contains_key val record

test "record contains_key" {
  let record = {| 'a => 1, 'b => 2 |}
  assert contains_key 'a record
  assert contains_key 'b record
  assert !(contains_key 1 record)
}

func group_by to_key iterator =
  let record = {||},
  with { iterator!(); record } {
    when 'next(item) then {
      let key = to_key item
      record.key = with [..record.key, item] {
        when 'mia resume []
      }
      become unit
    }
  }

test "record group_by" {
  assert group_by (fn x. x % 2) (it::from [1, 2, 3, 4, 5, 6]) == {| 0 => [2, 4, 6], 1 => [1, 3, 5] |}
}

func group iterator =
  let record = {||},
  with { iterator!(); record } {
    when 'next(key:val) then {
      record.key = with [..record.key, val] {
        when 'mia resume []
      }
      become unit
    }
  }

test "record group" {
  assert group (it::from [1:1, 2:2, 1:3, 2:4, 1:5, 2:6]) == {| 2 => [2, 4, 6], 1 => [1, 3, 5] |}
}

func collect iterator =
  let record = {||},
  with { iterator!(); record } {
    when 'next(key:val) then {
      record.key = val
      become unit
    }
  }

test "record collect" {
  let iterator = do() {
    yield 'next(1: 'a)
    yield 'next(2: 'b)
    yield 'next(3: 'c)
    yield 'next(2: 'd)
    yield 'next(1: 'e)
  }
  assert collect iterator == {| 3 => 'c, 2 => 'd, 1 => 'e |}
}
